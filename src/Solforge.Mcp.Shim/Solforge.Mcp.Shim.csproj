<Project Sdk="Microsoft.NET.Sdk">
  <!-- Solforge Phase 47B: solforge-mcp.exe, the stdio shim for MCP clients that only speak stdio.
       It links the discovery reader instead of referencing Solforge.Mcp, so a trimmed publish stays small. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>solforge-mcp</AssemblyName>
    <RootNamespace>Solforge.Mcp.Shim</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Solforge.Mcp/McpDiscovery.cs" Link="McpDiscovery.cs" />
  </ItemGroup>
</Project>
